# Copy to .env and fill in real values. Never commit .env.

# SQLite locally; swap to a Postgres connection string in production.
DATABASE_URL="file:./dev.db"

# Any random string — used to sign NextAuth JWTs.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- AI provider (chat + admin content-import normalization) ---
# Multiple providers are supported; everything else in the app works fine
# with none of these set (falls back to MockProvider — clearly-labeled
# demo replies, no AI cost).
#
# AI_PROVIDER explicitly picks one: "gemini" | "anthropic" | "mock".
# Leave unset to auto-detect by whichever key below is present (Gemini is
# checked first — it has a free tier, which is why this project defaults
# to recommending it over Claude).
AI_PROVIDER="gemini"

# Get a free-tier key at https://aistudio.google.com/apikey.
GOOGLE_GEMINI_API_KEY=""
# Optional — override the Gemini model (default: gemini-2.0-flash).
# GEMINI_MODEL="gemini-2.0-flash"

# Optional — get a key at https://console.anthropic.com/ (paid, no free tier).
ANTHROPIC_API_KEY=""

# Optional — override the seeded student's login (npm run db:seed).
# STUDENT_EMAIL="student@lexi.local"
# STUDENT_PASSWORD="lexi1234"
# STUDENT_NAME="Bạn học"

# Optional — override the seeded admin login (npm run db:seed). The admin
# account is the only one that can reach /admin/content-import.
# ADMIN_EMAIL="admin@lexi.local"
# ADMIN_PASSWORD="lexi-admin-1234"
# ADMIN_NAME="Quản trị viên"
