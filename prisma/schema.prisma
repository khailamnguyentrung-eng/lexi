// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// NOTE on datasource provider: this schema targets SQLite for local
// development because this environment has no local Postgres/Docker
// available. For production, switch `provider` below to "postgresql"
// (e.g. Neon) and point DATABASE_URL at it — the schema itself (field
// names, relations, enums) is portable. A few native-type annotations
// (Decimal/Text/VarChar) were intentionally omitted since SQLite doesn't
// support them; re-add `@db.Decimal`, `@db.Text`, `@db.VarChar` to the
// relevant fields when moving to Postgres if column-level precision matters.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────
// USERS & LEARNER PROFILE
// ──────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         LearnerProfile?
  chatSessions    ChatSession[]
  errorEntries    ErrorNotebookEntry[]
  skillMatrix     SkillMatrixEntry[]
  programProgress UserProgramProgress[]
  attempts        QuestionAttempt[]

  // Future admin content pipeline — unused by the MVP student flow.
  contentSources                ContentSource[]          @relation("UploadedContentSources")
  reviewedExtractedDrafts       ExtractedQuestionDraft[] @relation("ReviewedExtractedDrafts")
  reviewedPendingKnowledgeUnits PendingKnowledgeUnit[]   @relation("ReviewedPendingKnowledgeUnits")

  diagnosticTests DiagnosticTest[]
  moodEntries     MoodEntry[]

  assistanceExchanges     AssistanceExchange[]
  recommendationIssuances RecommendationIssuance[]
  recommendationResponses RecommendationResponse[]
  reviewEngagements       ReviewEngagement[]
  mockTestAttempts        MockTestAttempt[]
}

model LearnerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  gradeLevel      String @default("grade9")
  targetExam      String @default("hanoi_thpt_2027")
  targetScore     Float
  currentScore    Float?
  diagnosticScore Float?

  strengths       String? // JSON array, e.g. ["reading_comprehension"]
  weaknesses      String? // JSON array; MVP: manual/rule-derived, future: AI-written
  learningHistory String? // JSON array of timeline events

  preferredAmbientSound String? // future Focus Mode, unused in MVP
  onboardingCompletedAt DateTime?
  targetGoalDate        DateTime? // student's learning goal deadline (exam date, term end, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────
// QUESTION BANK — normalized per product requirement
// ──────────────────────────────────────────────────────────────────

enum QuestionType {
  PHONETICS_SOUND
  PHONETICS_STRESS
  GRAMMAR_MCQ
  WORD_FORMATION
  ERROR_IDENTIFICATION
  CLOZE
  READING_COMPREHENSION
  SENTENCE_TRANSFORMATION
}

enum SkillCategory {
  PHONETICS_STRESS
  VOCAB_GRAMMAR
  COMMUNICATION
  READING
  WRITING_TRANSFORMATION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ──────────────────────────────────────────────────────────────────
// RESPONSE FORMAT (QM-1 — question model reform)
// ──────────────────────────────────────────────────────────────────
// The axis this model was missing. `QuestionType` above conflates WHAT is
// tested with HOW it is answered (`GRAMMAR_MCQ` carries the format in its own
// name), and it overlaps `SkillCategory` — `PHONETICS_STRESS` is a member of
// BOTH enums. Between `type`, `skill` and `topic`/`knowledgeUnitId` there were
// three overlapping "what" axes and no "how" axis at all.
//
// ResponseFormat is that missing axis, and ONLY that: how the learner produces
// an answer, independent of subject. It is deliberately small and format-
// shaped, not exam-shaped — "IELTS matching headings" is MATCHING, and so is
// any other pairing task from any other exam. A new exam must not require a new
// enum member; that is the test this enum has to keep passing.
//
// See docs/QUESTION_MODEL_REFORM.md for why the payload is JSON and what stays
// in columns.
enum ResponseFormat {
  SINGLE_CHOICE // pick exactly one of N options. Covers the A/B/C/D MCQ this app was built on AND IELTS True/False/Not Given (same shape, 3 options)
  MULTI_CHOICE // pick M of N options
  SHORT_TEXT // PRODUCE text into one or more blanks — gap fill, word formation, sentence transformation
  MATCHING // pair each left item with a right item — IELTS matching headings/information/features
  ORDERING // arrange items into the correct sequence
}

model Passage {
  id             String   @id @default(cuid())
  title          String?
  bodyText       String
  passageType    String   @default("reading")
  sourceProvince String? // future multi-province expansion
  sourceYear     Int?
  createdAt      DateTime @default(now())

  questions Question[]
}

model Question {
  id           String        @id @default(cuid())
  questionCode String        @unique // human-readable, e.g. "DIAG36_Q01"
  type         QuestionType
  skill        SkillCategory
  difficulty   Difficulty    @default(MEDIUM)
  topic        String // e.g. "reported_speech" — required, normalized
  promptText   String

  // ── Answer shape (QM-1) ──────────────────────────────────────────
  // `payload` holds everything format-specific: the options, the blanks, the
  // pairs, and the correct answer. Its shape is defined and validated per
  // format in lib/services/question-format — NOT here, because it varies by
  // ResponseFormat and no single column set can hold all of them (which is
  // exactly how this model got stuck at 4-option MCQ).
  //
  // The division of labour is the whole design: columns hold what the system
  // QUERIES (topic, skill, difficulty, knowledgeUnitId — the coverage report
  // and the Decision Engine read these); JSON holds what only the GRADER reads.
  // Nothing queryable may move into the payload.
  //
  // Nullable only for the migration window — backfilled for all rows by
  // prisma/backfill-question-payload.ts. Read it via getQuestionPayload(),
  // never directly: that accessor is the single place where a legacy
  // optionA-D row and a payload row stop looking different.
  responseFormat ResponseFormat @default(SINGLE_CHOICE)
  payload        String? // JSON, shape depends on responseFormat

  // ── Legacy MCQ columns (QM-1: superseded by `payload`) ────────────
  // Kept and still written so the 29 files reading them keep working; the
  // reform is additive on purpose. `payload` is authoritative once backfilled.
  // Drop these only after every reader moves to getQuestionPayload() — tracked
  // in docs/QUESTION_MODEL_REFORM.md §6, deliberately NOT done in one step.
  optionA           String
  optionB           String
  optionC           String
  optionD           String
  correctOption     String // "A" | "B" | "C" | "D"
  explanationVi     String
  commonMistake     String? // explicit normalization field
  learningObjective String? // explicit normalization field
  source            String // e.g. "Bo_de_test_Tieng_Anh_9 - diagnostic_36q"
  sourceExam        String? // nullable now; future "hanoi_2025" etc.
  tags              String? // JSON object; future-only facets (province, examYear...)

  passageId String?
  passage   Passage? @relation(fields: [passageId], references: [id])

  // Content Intelligence (M3.1) — nullable; null for seeded/extracted questions
  knowledgeUnitId   String?
  knowledgeUnit     KnowledgeUnit?         @relation(fields: [knowledgeUnitId], references: [id])
  generatedViaJobId String?
  generatedViaJob   QuestionGenerationJob? @relation("GeneratedQuestions", fields: [generatedViaJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts      QuestionAttempt[]
  errorEntries  ErrorNotebookEntry[]
  mockTestSlots MockTestTemplateQuestion[]

  @@index([skill, topic])
  @@index([type])
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  // `selectedOption` (QM-1: legacy) — an "A"|"B"|"C"|"D" letter cannot express
  // typed text, a set of pairs, or an ordering. Kept for the existing readers;
  // `response` supersedes it.
  selectedOption      String
  // JSON, shape mirrors the question's ResponseFormat. See
  // lib/services/question-format. Nullable: not backfilled, deliberately —
  // V1_V2_RECONCILIATION.md rules all 31 existing attempt rows are dev
  // click-testing and get dropped, so converting them would be work spent on
  // rows already scheduled for deletion.
  response            String?
  isCorrect           Boolean
  // Partial credit, 0..1 — a MATCHING question with 3 of 4 pairs right is not
  // simply "wrong". Nullable because binary formats don't need it, and
  // `isCorrect` stays authoritative for every existing accuracy calculation
  // (analytics reads it in ~10 places; changing its meaning would silently
  // rewrite every mastery number).
  score               Float?
  timeSpentSec        Int?
  attemptedAt         DateTime           @default(now())

  // Set when this answer was submitted during a mock test — an answer
  // given during a mock test is still just a QuestionAttempt, tagged with
  // which session it belongs to. See "MOCK TEST" section below for why
  // there's no separate AnswerRecord table.
  mockTestAttemptId String?
  mockTestAttempt   MockTestAttempt? @relation(fields: [mockTestAttemptId], references: [id])

  // Set when this answer was submitted from a Program lesson slot (v2 spine —
  // see Program/ProgramCurriculum below), same pattern as mockTestAttemptId
  // above: an attempt is still just a QuestionAttempt, tagged with which
  // context it happened in. Added because /program/[slug]/[order] shipped
  // in PR #15 without threading ANY session-context through — Program-slot
  // attempts were being recorded with every context FK null, invisible to
  // behaviorEngine/studentLearningProfile/practiceRecommendation. This is
  // the fix, first of the "retire CurriculumSession" batch
  // (docs/DECISION_LOG.md).
  programCurriculumId String?
  programCurriculum   ProgramCurriculum? @relation(fields: [programCurriculumId], references: [id])

  @@index([userId, questionId])
  @@index([userId, mockTestAttemptId])
  @@index([userId, programCurriculumId])
}

// ──────────────────────────────────────────────────────────────────
// ERROR NOTEBOOK
// ──────────────────────────────────────────────────────────────────

enum ErrorStatus {
  OPEN
  REVIEWING
  MASTERED
}

model ErrorNotebookEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id])

  studentAnswer     String
  correctAnswer     String
  reason            String
  concept           String // links to skill matrix
  occurrenceCount   Int     @default(1)
  isRemedialFlagged Boolean @default(false)

  // Spaced repetition fields — present now, MVP uses a simple fixed-offset
  // stub; future SM-2 scheduler only changes the write logic, not the schema.
  reviewStage    Int       @default(0) // maps to Day 1/3/7/14/30 later
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  easeFactor     Float? // unused in MVP, future SM-2 input

  status ErrorStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewEngagements ReviewEngagement[]

  @@index([userId, nextReviewAt])
  @@index([userId, concept])
}

// ──────────────────────────────────────────────────────────────────
// SKILL MATRIX / PROGRESS
// ──────────────────────────────────────────────────────────────────

enum ComputeSource {
  MANUAL
  RULE_BASED
  AI
}

model SkillMatrixEntry {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  skill          SkillCategory
  percentage     Float
  computedBy     ComputeSource @default(MANUAL)
  lastComputedAt DateTime      @default(now())

  @@unique([userId, skill])
}

// ──────────────────────────────────────────────────────────────────
// CURRICULUM / LESSONS — normalized per product requirement
// ──────────────────────────────────────────────────────────────────

enum SessionType {
  REGULAR
  CHECKPOINT
  MINI_TEST
  MOCK_EXAM
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/**
 * Structural mirror of UserSessionProgress, for the ProgramCurriculum (v2)
 * spine instead of CurriculumSession. Both spines run in parallel on
 * purpose (docs/DECISION_LOG.md) — this table exists so a Program slot's
 * start/complete lifecycle can be tracked the same way a CurriculumSession's
 * always could, even though (per investigation on 2026-07-26) that tracking
 * was never actually wired into the UI for CurriculumSession either until
 * this same change. See lib/analytics/behaviorEngine.ts for the consumer
 * this eventually unblocks (not yet repointed — separate follow-up).
 */
model UserProgramProgress {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  programCurriculumId String
  programCurriculum   ProgramCurriculum @relation(fields: [programCurriculumId], references: [id])
  status              ProgressStatus    @default(NOT_STARTED)
  startedAt           DateTime?
  completedAt         DateTime?
  scoreAchieved       Float?

  @@unique([userId, programCurriculumId])
}

// ──────────────────────────────────────────────────────────────────
// LEXI AI CHATBOT
// ──────────────────────────────────────────────────────────────────

enum ChatMode {
  TEACHER
  ERROR_DETECTIVE
  PRACTICE_GENERATOR
  EXAM_COACH
  MOTIVATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  mode            ChatMode @default(TEACHER)
  title           String?
  contextSnapshot String? // JSON snapshot of what was injected at session start
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  role          MessageRole
  content       String
  attachmentUrl String? // unused in MVP, future Error Detective Mode
  tokensUsed    Int?
  createdAt     DateTime    @default(now())

  @@index([chatSessionId, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// CONTENT IMPORT PIPELINE (admin tooling — /admin/content-import)
// ──────────────────────────────────────────────────────────────────
// Flow: admin uploads a PDF/DOCX/image (ContentSource) -> runs an
// ImportJob (extraction + normalization — currently a placeholder that
// returns canned sample drafts, see lib/services/contentImport.ts) ->
// each candidate question becomes an ExtractedQuestionDraft -> human
// reviews/edits -> approved drafts become real Question rows. A
// ContentSource can have multiple ImportJobs (e.g. re-run after improving
// extraction) — job-level status is separate from the source itself.

enum ContentFileType {
  PDF
  DOCX
  IMAGE
}

model ContentSource {
  id          String          @id @default(cuid())
  userId      String // admin who uploaded it
  user        User            @relation("UploadedContentSources", fields: [userId], references: [id])
  fileName    String
  fileType    ContentFileType
  // Storage location for the raw file — local path or future object-storage
  // URL (e.g. S3/Vercel Blob). Kept as a plain string so swapping storage
  // backends later doesn't require a schema change.
  storagePath String
  sourceLabel String? // e.g. "Hai Phong 2026 entrance exam" — free text, future tagging

  // Exam tagging metadata — supports the future multi-province/year exam
  // database (see Question.tags/sourceProvince/sourceYear). Optional and
  // admin-entered at upload time; nullable since not every source is a
  // dated provincial exam (e.g. a generic worksheet).
  province       String? // e.g. "Hà Nội", "Hải Phòng"
  examYear       Int? // e.g. 2026
  examType       String? // e.g. "official_exam", "mock_exam", "practice"
  gradeLevel     String? // e.g. "grade9" — matches LearnerProfile.gradeLevel
  subject        String? // e.g. "english" — forward-looking, app is English-only today
  // Original uploaded file name, captured separately from `fileName` in
  // case a future pipeline step renames/splits files (e.g. unzipping a
  // multi-file archive) and `fileName` no longer matches what was uploaded.
  sourceFileName String?

  createdAt DateTime @default(now())

  importJobs            ImportJob[]
  sourceReads           SourceRead[]
  pendingKnowledgeUnits PendingKnowledgeUnit[]
}

enum ImportJobStatus {
  PENDING // job created, not yet run
  EXTRACTING // AI extraction in progress
  EXTRACTED // raw text extracted, ready to normalize
  REVIEWING // drafts created, awaiting human review
  IMPORTED // all approved drafts written to Question
  FAILED // extraction/normalization errored
}

model ImportJob {
  id              String        @id @default(cuid())
  contentSourceId String
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id])

  status           ImportJobStatus @default(PENDING)
  rawExtractedText String? // AI extraction output, pre-normalization
  errorMessage     String? // set when status = FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts ExtractedQuestionDraft[]
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  EDITED // admin changed fields before approving
  REJECTED
}

// Validation outcome from contentValidation.ts, stored on GeneratedQuestionDraft.
enum DraftValidationStatus {
  PASS // no issues
  WARNING // low/medium severity issues only
  FAIL // at least one high-severity issue — draft cannot be approved
}

model ExtractedQuestionDraft {
  id          String    @id @default(cuid())
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id])

  // Proposed fields produced by extraction/normalization, shaped like the
  // target Question seed format (see prisma/seed-data/questions.json) until
  // a human approves it. JSON keeps this decoupled from schema changes on
  // Question itself.
  normalizedData String

  reviewStatus     ReviewStatus @default(PENDING_REVIEW)
  reviewedByUserId String?
  reviewedBy       User?        @relation("ReviewedExtractedDrafts", fields: [reviewedByUserId], references: [id])
  reviewNote       String?

  // Set once APPROVED and the real row has been created, so re-running
  // import never duplicates a question.
  importedQuestionId String?

  // Content Intelligence (M3.1) — null for extraction-origin drafts
  generationJobId String?
  generationJob   QuestionGenerationJob? @relation("GenerationDrafts", fields: [generationJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importJobId, reviewStatus])
}

// ──────────────────────────────────────────────────────────────────
// CONTENT INTELLIGENCE (Phase 3 — M3.1 foundation)
// ──────────────────────────────────────────────────────────────────
// KnowledgeUnit: canonical topic registry. One row per topic string,
// recording display label and target question counts per difficulty band.
// Enables the content gap analysis engine. (Previously also bridged to
// CurriculumSession via a join table, KnowledgeUnitOnSession — that table
// was never actually written to by any code path and was dropped along
// with CurriculumSession itself; see docs/superpowers/plans/
// 2026-07-28-retire-curriculumsession-phase2.md.)
//
// QuestionGenerationJob: minimal foundation for admin-triggered AI
// generation. Full provider/cost fields deferred to M3.3+. Drafts produced
// by a job reuse the existing ExtractedQuestionDraft → approveDraft() flow.

model KnowledgeUnit {
  id                String @id @default(cuid())
  topic             String @unique // must match Question.topic exactly (canonical snake_case)
  label             String // human-readable Vietnamese label
  targetEasyCount   Int    @default(5)
  targetMediumCount Int    @default(5)
  targetHardCount   Int    @default(3)

  questions         Question[]
  generatedDrafts   GeneratedQuestionDraft[]         @relation("GeneratedDraftsForUnit")
  resolvedProposals PendingKnowledgeUnit[]
  programSlots      ProgramCurriculumKnowledgeUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic]) // fast lookup during coverage computation
}

// ──────────────────────────────────────────────────────────────────
// KU-1 PART B — SOURCE → PENDING KNOWLEDGE UNIT → REVIEW QUEUE
// ──────────────────────────────────────────────────────────────────
// docs/KU1_PARTB_DESIGN.md. The gap this closes: autoAssignKnowledgeUnit()
// silently discards any topic with no matching KnowledgeUnit (a plain
// `return false`). That silent discard is why the bank sits at 74 distinct
// topic strings against 12 KnowledgeUnits, and why an IELTS/academic source
// cannot grow the taxonomy at all today — its topics would just vanish the
// same way.
//
// Two paths are deliberately kept separate (design doc §1):
//   Path A (this section) — source → proposed KnowledgeUnits. Never touches
//     Question. Low-risk, and is literally what "Lexi đọc và tạo được KU"
//     from a source asks for.
//   Path B (existing content-import pipeline) — source → Question rows.
//     Unchanged by this section, except the one-line miss-handling change
//     described on PendingKnowledgeUnit.taxonomyJobId below.
//
// SourceRead is the shared extraction stage both paths (and a future Path C
// for exam-paper structure) read from, so a source is never re-extracted
// per path — see design doc §1.5's "extract once, fan out".

enum SourceReadStatus {
  PENDING
  READING
  READ
  FAILED
}

model SourceRead {
  id              String           @id @default(cuid())
  contentSourceId String
  contentSource   ContentSource    @relation(fields: [contentSourceId], references: [id])
  status          SourceReadStatus @default(PENDING)

  // The single cached extraction. ImportJob keeps its own rawExtractedText
  // for now (design doc §4.2) — not duplicated here, and not read from here
  // yet, so Path B stays completely undisturbed by this addition.
  rawExtractedText String?
  chunks           String? // JSON DocumentChunk[] — chunker output, cached
  chunkCount       Int?
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxonomyJobs TaxonomyJob[]
}

enum TaxonomyJobStatus {
  PENDING
  PROPOSING // AI call in progress
  PROPOSED // proposals created, awaiting human review
  RESOLVED // every proposal for this job has left PENDING_REVIEW
  FAILED
}

model TaxonomyJob {
  id           String            @id @default(cuid())
  sourceReadId String
  sourceRead   SourceRead        @relation(fields: [sourceReadId], references: [id])
  status       TaxonomyJobStatus @default(PENDING)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals PendingKnowledgeUnit[]
}

enum PendingKUStatus {
  PENDING_REVIEW
  APPROVED
  MERGED
  RENAMED
  REJECTED
}

model PendingKnowledgeUnit {
  id String @id @default(cuid())

  // Provenance — always set: which source proposed this topic, regardless of
  // which path produced the proposal.
  contentSourceId String
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id])

  // Nullable: only set when a Path A TaxonomyJob produced this proposal. A
  // proposal recorded by the Path B miss-handling below (autoAssignKnowledgeUnit
  // finding no matching KnowledgeUnit) has no TaxonomyJob — Path B never runs
  // one — so this stays null in that case. See design doc §4.1.
  taxonomyJobId String?
  taxonomyJob   TaxonomyJob? @relation(fields: [taxonomyJobId], references: [id])

  proposedTopic String // canonicalTopic()-normalized; deliberately NOT unique —
  // duplicates across sources are expected and are exactly what
  // the review queue's MERGE action exists to collapse.
  proposedLabel String // human-readable (Vietnamese for VN exams, English for
  // international sources — no forced-translation rule)

  // Load-bearing: reviewing "is this a real KnowledgeUnit?" without seeing
  // what in the source caused the proposal is guesswork. Mirrors the
  // provenance discipline in RecommendationIssuance (Basis) and
  // ReviewEngagement (snapshot at review time).
  evidenceQuote    String
  evidenceLocation String? // e.g. "Test 2 / Reading Passage 1"

  aiConfidence Float?

  reviewStatus     PendingKUStatus @default(PENDING_REVIEW)
  reviewedByUserId String?
  reviewedBy       User?           @relation("ReviewedPendingKnowledgeUnits", fields: [reviewedByUserId], references: [id])
  reviewNote       String?

  // Set on APPROVE (a new KnowledgeUnit was created) or MERGE (an existing
  // one was chosen instead). Null while PENDING_REVIEW, and stays null on
  // REJECTED/RENAMED-without-resolution.
  resolvedUnitId String?
  resolvedUnit   KnowledgeUnit? @relation(fields: [resolvedUnitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposedTopic])
  @@index([reviewStatus])
}

enum GenerationJobStatus {
  PENDING // job created, not yet run
  GENERATING // AI call in progress
  REVIEWING // drafts created, awaiting human review
  COMPLETED // all drafts reviewed
  FAILED // AI call or draft creation errored
}

model QuestionGenerationJob {
  id           String              @id @default(cuid())
  topic        String
  difficulty   Difficulty
  targetCount  Int
  status       GenerationJobStatus @default(PENDING)
  errorMessage String? // set when status = FAILED

  drafts          ExtractedQuestionDraft[] @relation("GenerationDrafts")
  questions       Question[]               @relation("GeneratedQuestions")
  generatedDrafts GeneratedQuestionDraft[] @relation("GeneratedDrafts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────
// GENERATED QUESTION DRAFT (Phase 3 — M4.3)
// ──────────────────────────────────────────────────────────────────
// Separate from ExtractedQuestionDraft: generated content has a different
// provenance (QuestionGenerationJob, not ImportJob) and different lifecycle
// needs. Using a separate model keeps import and generation audit trails clean.

model GeneratedQuestionDraft {
  id String @id @default(cuid())

  // Generation job that produced this draft
  generationJobId String
  generationJob   QuestionGenerationJob @relation("GeneratedDrafts", fields: [generationJobId], references: [id])

  // Topic registry entry the draft was generated for
  knowledgeUnitId String
  knowledgeUnit   KnowledgeUnit @relation("GeneratedDraftsForUnit", fields: [knowledgeUnitId], references: [id])

  // Question content — all fields needed to create a Question row at approval.
  // questionType and questionSkill are stored as String (not enum) because the
  // AI output string is validated at approval time, matching how importer.ts
  // handles the normalizedData cast.
  questionCode      String
  topic             String
  difficulty        Difficulty
  promptText        String
  optionA           String
  optionB           String
  optionC           String
  optionD           String
  correctOption     String // "A" | "B" | "C" | "D"
  explanationVi     String
  commonMistake     String?
  learningObjective String?
  questionType      String // QuestionType value, cast to enum at approval
  questionSkill     String // SkillCategory value, cast to enum at approval
  source            String // "generated:<topic>:<difficulty>"

  // Review lifecycle — reuses existing ReviewStatus enum
  status     ReviewStatus @default(PENDING_REVIEW)
  reviewNote String?

  // Validation result written at draft creation by contentValidation.ts.
  // FAIL drafts are blocked from approval.
  validationStatus DraftValidationStatus @default(PASS)
  validationIssues String? // JSON: ValidationIssue[]

  // Set when APPROVED — prevents duplicate Question creation on re-approval
  approvedQuestionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([generationJobId, status])
}

// ──────────────────────────────────────────────────────────────────
// DIAGNOSTIC TEST
// ──────────────────────────────────────────────────────────────────

model DiagnosticTest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  grammarScore    Float
  vocabularyScore Float
  readingScore    Float
  estimatedLevel  String // e.g. "A2", "B1" — free string, simple rule-derived in MVP

  takenAt DateTime @default(now())

  @@index([userId, takenAt])
}

// ──────────────────────────────────────────────────────────────────
// LEARNING MOOD TRACKING
// ──────────────────────────────────────────────────────────────────

enum Mood {
  GREAT
  GOOD
  OKAY
  TIRED
  STRESSED
}

model MoodEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  mood Mood
  note String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// LENS ASSISTANCE (LX-1 reconciliation)
// ──────────────────────────────────────────────────────────────────
// An immutable record of one AI-assistance exchange: the learner
// captured an external stimulus (selected text / screenshot / image),
// and Lexi returned one non-graded assistance response. This is an
// Evidence-layer Fact (Ch.1 §3.2 — "an interaction"), not a Projection.
// Closes the Constitution 5.5 / Rule 7 gap where assistFromCapture()
// produced a response that left no trace in the learner's record.
//
// Append-only by design (Ch.1 Invariant 4): "regenerate" creates a new
// row, never mutates an existing one — matching the frozen
// AssistanceExchange domain identity.

enum AssistanceCaptureType {
  TEXT_SELECTION
  IMAGE_UPLOAD
  SCREENSHOT_REGION
}

enum AssistanceStyleType {
  GUIDED_STEPS
  VOCABULARY_MEANING
  CONCEPT_EXPLANATION
  SUMMARY
  GENERAL_HELP
}

model AssistanceExchange {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  captureType     AssistanceCaptureType
  capturedText    String // the literal selection or OCR-extracted text the AI reasoned over (never the raw image bytes)
  assistanceStyle AssistanceStyleType
  responseContent String // JSON-serialized produced content (explanation string or steps[]) — same convention as ChatSession.contextSnapshot
  confidence      Float
  flags           String // JSON-serialized LensFlag[] — preserves response caveats (OCR_CONFIDENCE_LOW, AI_PARSE_ERROR, …)

  // Infrastructure/provider-registry identity (which AI provider served this
  // exchange), NOT a closed domain category — deliberately a String, not an
  // enum, because the provider set is an infra concern expected to grow, unlike
  // the domain-fixed captureType/assistanceStyle above. Stands in for the Ch.1
  // §3.1 Evaluator; a full Evaluator entity remains a pre-existing system Gap.
  providerName String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// RECOMMENDATION ISSUANCE (H-1/H-2 reconciliation, Option B — PD3 Reading A)
// ──────────────────────────────────────────────────────────────────
// Ch.3 §3.1: a Recommendation itself has "no stored identity, computed fresh,
// ephemeral — never a durable record updated in place. What IS permanent is
// the fact of its issuance" (Ch.1 Invariant 12). This table IS that fact —
// append-only, one row per issuance, never updated. "Current" is deliberately
// NOT a stored flag: it is the most recent row per userId (the same
// latest-wins idiom already used by ChatSession's own "current session"
// lookup), which is one of the "conforming implementations" Ch.3 §3.1
// explicitly permits ("retire-then-publish, publish-then-flip, and
// transactional replacement are all conforming"). Supersession is therefore
// implicit: an old row simply stops being the most recent one.

enum RecommendationSuggestedAction {
  REVIEW_NOTEBOOK
  PRACTICE_TOPIC
  ADVANCE_SESSION
}

enum RecommendationPriorityLabel {
  RECURRING_MISTAKE
  DUE_REVIEW
  WEAKNESS_SIGNAL
  CURRICULUM_PROGRESS
}

// Firmness (Ch.3 §3.1) — how strongly the recommendation is offered, bounded
// above by belief-confidence (5.10). Mirrors the RecommendationConfidence union
// (LOW/MEDIUM/HIGH); a closed domain set, so an enum per this schema's
// "closed set → enum" convention.
enum RecommendationFirmness {
  LOW
  MEDIUM
  HIGH
}

model RecommendationIssuance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Identity-bearing fields (Ch.3 §3.1 Fields) — compared in Phase 3 to
  // detect whether a new computation actually supersedes the current one.
  // Exactly one of topic/sessionNumber is set. sessionNumber is a reused
  // generic label — held a CurriculumSession number historically, now holds
  // a ProgramCurriculum slot's `order` (PracticeRecommendation.mission.order)
  // since the v2 repoint; not renamed to avoid a migration for a label-only change.
  topic           String?
  sessionNumber   Int?
  suggestedAction RecommendationSuggestedAction // Intent
  priorityLabel   RecommendationPriorityLabel // Basis provenance handle — which evidence category this was computed from (not a stored Understanding reference; none exists to point to)
  procedure       String // Decision Procedure identity, e.g. "computeRecommendations@v1" — provenance only, never "what did the procedure contain"

  // Basis — Goal citation (Ch.3 §3.1 Fields; Inv 2 requires every Goal served
  // to be cited). Goal is represented as scalar LearnerProfile fields, not a
  // separate entity (PR-1's already-accepted compatible reading: single-goal
  // is a valid "zero-or-more, never assumed one" subset). LearnerProfile is
  // mutable (PR-2 Layer 1: a Learner Declaration, updated in place, not
  // append-only) — so citing it here means SNAPSHOTTING the Goal values in
  // effect at issuance time, never a live FK to the current profile row,
  // which would silently drift as the profile changes later. Still not a
  // pointer to a stored Understanding (none exists to point to, per Basis's
  // priorityLabel field above) — this closes the Goal-citation half of Basis
  // specifically, not the Understanding-pointer half, which the architecture
  // does not currently support persisting.
  goalTargetExam  String? // snapshot of LearnerProfile.targetExam
  goalTargetScore Float? // snapshot of LearnerProfile.targetScore
  goalTargetDate  DateTime? // snapshot of LearnerProfile.targetGoalDate

  // Required, non-identity (Ch.3 §3.1). Carries the timestamp of the most
  // recent QuestionAttempt the computation could have reflected — an
  // evidence-freshness proxy, NOT a real Understanding-version identifier
  // (no durable Understanding exists anywhere in this codebase to version).
  // Falls back to the write moment only for learners with zero attempts.
  asOf DateTime

  // ── Phase 4 (Evidence enrichment) — the remaining §3.1 Contract fields ──
  // Representational, NON-identity: never participate in the supersession
  // comparison (Phase 3 unchanged); stored so the issuance Evidence is a
  // faithful record of the whole Recommendation that was issued, not just the
  // identity subset — supporting §3.1 Invariant 5's "stay auditable". Nullable
  // because they are enrichment, not required by PD3's four named obligations.
  rationale String? // Rationale — the "why" text presented to the learner (prescriptive, references the belief it derived from)
  firmness  RecommendationFirmness? // Firmness — how strongly offered, bounded by basis-confidence

  issuedAt DateTime @default(now())

  responses RecommendationResponse[]

  @@index([userId, issuedAt])
}

// ──────────────────────────────────────────────────────────────────
// RECOMMENDATION RESPONSE (RT-1 reconciliation — Ch.3 §3.1 "Consumed")
// ──────────────────────────────────────────────────────────────────
// Ch.3 §3.1 Lifecycle: "Consumed — read and acted on... Only the targeted
// Learner's own response to the recommended Action — accepted, overridden,
// or ignored — becomes Evidence." §3.3 Invariant 5: the learner's response
// "is recorded as Evidence." This table IS that Evidence — append-only, one
// row per response event, never updated (Ch.1 Inv 4). Deliberately a
// SEPARATE table from RecommendationIssuance: consuming a Recommendation
// must never mutate the issuance record (which is itself append-only
// Evidence of a different event).
//
// Only ACCEPTED is implemented today. OVERRIDDEN and IGNORED are real §3.1
// response types but both require thresholds Ch.3 §3.5 deliberately leaves
// open (e.g. how long un-acted-upon counts as "ignored") — the enum starts
// with the one value whose trigger is unambiguous (the learner clicked the
// recommended action's own CTA), rather than guessing at the other two.

enum RecommendationResponseType {
  ACCEPTED
}

model RecommendationResponse {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  recommendationIssuanceId String
  recommendationIssuance   RecommendationIssuance @relation(fields: [recommendationIssuanceId], references: [id])

  responseType RecommendationResponseType

  respondedAt DateTime @default(now())

  @@index([userId, respondedAt])
  @@index([recommendationIssuanceId])
}

// ──────────────────────────────────────────────────────────────────
// REVIEW ENGAGEMENT (RV-1 reconciliation — Ch.3 §3.3 Inv 5 / §3.1 "Consumed")
// ──────────────────────────────────────────────────────────────────
// An immutable record of one learner-initiated review: the learner opened a
// past mistake and reported having reviewed it. Ch.3 §3.1 Lifecycle "Consumed"
// — "Only the targeted Learner's own response to the recommended Action —
// accepted, overridden, or ignored — becomes Evidence"; §3.3 Invariant 5
// requires that response be recorded as Evidence. Under BI-02's ruling
// (review/SM-2 scheduling is within Decision Policy jurisdiction), "review
// concept X, it is due" is a Recommendation with Intent = review, so the
// learner's "I reviewed it" is that Recommendation's Consumed response.
//
// Append-only (Ch.1 Invariant 4): reviewing the same entry twice creates two
// rows; no row is ever updated. Deliberately SEPARATE from ErrorNotebookEntry,
// whose reviewStage/nextReviewAt/easeFactor are a mutable Understanding-layer
// retention projection — that projection is not Evidence and is left unchanged.
//
// NOT FK-linked to a RecommendationIssuance: review items are not currently
// issued through the Issuance path (Option B serves practice recommendations
// only), so there is no issuance to point at. This is Evidence of the review
// engagement itself. Materialising review Recommendations is deferred work,
// per the RT-1 precedent — see docs/RV1_REVIEW_EVIDENCE_DESIGN.md §3.

model ReviewEngagement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  errorNotebookEntryId String
  errorNotebookEntry   ErrorNotebookEntry @relation(fields: [errorNotebookEntryId], references: [id])

  // Snapshot at review time. ErrorNotebookEntry.concept is mutable (the same
  // PATCH route's non-review branch edits it), so an Evidence record must
  // capture what was true when the review happened, never resolve it live
  // later. Same discipline as RecommendationIssuance's Goal citation snapshot.
  concept String

  // Light enrichment — makes the Evidence self-describing ("what did this
  // review accomplish") at zero query cost: the route already holds the
  // pre-update entry and computes the new stage. Representational, not
  // identity-bearing.
  reviewStageBefore Int
  reviewStageAfter  Int
  reachedMastery    Boolean

  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([errorNotebookEntryId])
}

// ──────────────────────────────────────────────────────────────────
// MOCK TEST (docs/MOCKTESTTAB_DESIGN.md)
// ──────────────────────────────────────────────────────────────────
// The design doc sketches a SEPARATE `Question` model scoped to a mock test
// (`mockTestId`, `contentJson`, `answerKey`). Deliberately not built that way
// here: this session's whole point (V1_V2_RECONCILIATION.md, QM-1, KU-1) was
// unifying the question bank into ONE `Question`/`ResponseFormat`/
// `KnowledgeUnit` model instead of leaving parallel copies. A mock test paper
// is a curated ORDERING of existing Question rows, not a new content type —
// so `MockTestTemplateQuestion` is a join table (matching the
// `KnowledgeUnitOnSession` precedent for "which rows compose this thing"),
// and a submitted answer is still a `QuestionAttempt` (extended with a
// nullable `mockTestAttemptId`, the same pattern `curriculumSessionId`
// already uses) — not a parallel `AnswerRecord` table. One Evidence table for
// every answer a learner ever submits, regardless of context.

model MockTestTemplate {
  id             String   @id @default(cuid())
  title          String // e.g. "Thi thử vào 10 — Hà Nội"
  description    String?
  timeLimitMin   Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  questions MockTestTemplateQuestion[]
  attempts  MockTestAttempt[]
}

// `order` is a plain column, not encoded in a JSON array on the template —
// queryable/indexable, and leaves room for a future per-slot field (e.g. a
// section label override) without a JSON schema migration.
model MockTestTemplateQuestion {
  id         String           @id @default(cuid())
  templateId String
  template   MockTestTemplate @relation(fields: [templateId], references: [id])
  questionId String
  question   Question         @relation(fields: [questionId], references: [id])
  order      Int // 1-based position in the paper

  @@unique([templateId, order])
  @@unique([templateId, questionId])
}

enum MockTestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model MockTestAttempt {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id])
  templateId String
  template   MockTestTemplate      @relation(fields: [templateId], references: [id])
  status     MockTestAttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  // Aggregate, computed once on submit from this attempt's QuestionAttempt
  // rows — nullable while IN_PROGRESS. Per-question correctness is NOT
  // revealed to the learner until submission (real exams don't grade
  // per-question mid-test); these three columns are what the results page
  // reads without recomputing.
  score        Float?
  correctCount Int?
  totalCount   Int?

  questionAttempts QuestionAttempt[]

  @@index([userId, status])
}

// ──────────────────────────────────────────────────────────────────
// PROGRAM (v2 curriculum spine — replaces CurriculumSession)
// ──────────────────────────────────────────────────────────────────
// docs/V1_V2_RECONCILIATION.md ruled CurriculumSession/CurriculumPhase for
// removal; this is the replacement, built additively at first (CurriculumSession
// remained UNCHANGED and still live — see the founder-facing scope note in the
// commit this section originally shipped with — until Phase 2 of the retirement
// plan removed it from the schema entirely; see docs/superpowers/plans/
// 2026-07-28-retire-curriculumsession-phase2.md). Two things this model deliberately gets right
// that CurriculumSession got wrong:
//
// 1. GENERIC, not hardcoded to one exam. Program is a named container (any
//    number of them), not an assumed single "the curriculum". The 24-session
//    Hà Nội content is seeded as exactly one Program — demo data filling a
//    general structure, not the structure itself.
//
// 2. A lesson slot maps to MANY KnowledgeUnits, not implicitly one topic.
//    Measured against the real curriculum data before designing this:
//    17 of the 24 existing sessions teach more than one grammarTopic at
//    once, and 6 are checkpoint/review sessions matching none by exact
//    string (they're deliberately cumulative). A single-topic-per-slot
//    model cannot represent the curriculum that already exists.
//
// The auto-assembly pipeline (lib/services/program/) is what makes "add a
// source, get a lesson" real: assembleProgramGaps() is idempotent — for
// every KnowledgeUnit not yet covered by any slot in a Program, it appends
// ONE new slot for it. Wired to run automatically after
// approvePendingKnowledgeUnit()/mergePendingKnowledgeUnit() resolve a KU-1
// part B proposal, so a newly-approved KnowledgeUnit gets a lesson slot in
// the SAME action a human approves it — no separate manual step. It only
// ever APPENDS; it never reorders or edits an existing slot, so a learner
// partway through a Program never has their progress reshuffled under them
// by a later import.

model Program {
  id          String   @id @default(cuid())
  slug        String   @unique // stable URL identifier, e.g. "thi-vao-10-ha-noi" — never displayed, never reused for a different Program
  title       String
  description String?
  targetExam  String? // e.g. "hanoi_thpt" — matches LearnerProfile.targetExam's convention, not a new vocabulary
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curriculum ProgramCurriculum[]
}

model ProgramCurriculum {
  id          String      @id @default(cuid())
  programId   String
  program     Program     @relation(fields: [programId], references: [id])
  order       Int // 1-based position — the only thing that determines sequence; no separate phase/week grouping (CurriculumPhase, now removed, only ever grouped "3 named bands of session numbers", reproducible by a UI range-label over `order` if ever needed, not a stored relation)
  title       String
  objective   String?
  // Reuses the existing SessionType enum (REGULAR/MINI_TEST/CHECKPOINT/
  // MOCK_EXAM) rather than a new one — its meaning was never
  // CurriculumSession-specific, and MOCK_EXAM here is a labelling concern
  // only (this is not how the real MockTestAttempt/MockTestTemplate flow
  // works; a Program slot of type MOCK_EXAM just means "this lesson is a
  // practice checkpoint", it does not create or link a MockTestAttempt).
  sessionType SessionType @default(REGULAR)

  knowledgeUnits   ProgramCurriculumKnowledgeUnit[]
  questionAttempts QuestionAttempt[] // attempts submitted while practicing this slot
  userProgress     UserProgramProgress[]

  @@unique([programId, order])
}

// Join table, not a JSON array on ProgramCurriculum — queryable (e.g. "which
// Program slots cover this KnowledgeUnit", the exact query
// assembleProgramGaps() runs), matching the KnowledgeUnitOnSession /
// MockTestTemplateQuestion precedent for "which rows compose this thing".
model ProgramCurriculumKnowledgeUnit {
  programCurriculumId String
  programCurriculum   ProgramCurriculum @relation(fields: [programCurriculumId], references: [id])
  knowledgeUnitId     String
  knowledgeUnit       KnowledgeUnit     @relation(fields: [knowledgeUnitId], references: [id])

  @@id([programCurriculumId, knowledgeUnitId])
}
